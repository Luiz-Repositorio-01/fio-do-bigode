# =============================================================================
# Fio do Bigode — variáveis de ambiente (copie para .env.local; NUNCA commite valores reais)
# A versão de DEMONSTRAÇÃO funciona sem NENHUMA destas variáveis.
# =============================================================================

# --- Site (públicas: vão para o navegador) ------------------------------------
# URL final do site (sitemap, canonical, JSON-LD, links de indicação).
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br
# Indexação no Google. Deixe VAZIO na demonstração (o site fica noindex). Só "true" no lançamento real.
NEXT_PUBLIC_ALLOW_INDEXING=
# Analytics (opcional — sem o ID, nenhum script é carregado)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Verificação do Google Search Console (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Backend real (FASE PÓS-APROVAÇÃO; hoje NÃO é lido pelo código) -------------
# Projeto Supabase DEDICADO à barbearia — nunca reutilize o de outro produto.
# A chave "anon/publishable" é pública por desenho: quem protege os dados é a RLS.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# A chave service_role BYPASSA a RLS: só em servidor/Edge Function/agendador. Jamais NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
